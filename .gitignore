# =============================================================================
# SentinelAI — .gitignore
#
# Covers: Java 21 / Spring Boot / Maven, React / Vite / Node, Docker,
#         IntelliJ IDEA, VS Code, Eclipse, macOS, Windows, Linux,
#         Claude / AI coding assistant session files.
# =============================================================================


# ── AI coding assistant session files ────────────────────────────────────────
# These files are generated by Claude Code / Cowork during development sessions.
# They contain internal task tracking and AI context — not useful to contributors.
CLAUDE.md
PROGRESS.md
COWORK_TASK.md
COWORK_*.md
REVIEW.md
HANDOFF.md
sentinelai-a16z-speedrun.pptx
sentinelai-a16z-speedrun.pdf
.deck-preview/
.claude/

# ── Extra sub-directory READMEs (generated during dev, not needed in public repo) ──
backend/README.md
backend/src/main/java/com/sentinelai/filter/README.md
docker/README.md
docs/README.md
frontend/README.md
frontend/src/api/README.md
frontend/src/components/README.md
frontend/src/hooks/README.md
frontend/src/pages/README.md
frontend/src/types/README.md


# ── Secrets — NEVER commit these ─────────────────────────────────────────────
# .env.example is the only .env file that should be committed
.env
.env.*
!.env.example

# Spring Boot local overrides (developer-specific, may contain credentials)
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-local.properties
**/application-secrets.yml
**/application-secrets.properties

# Private keys, certificates, keystores
*.pem
*.key
*.p12
*.jks
*.keystore
*.pfx


# ── Java / Maven ──────────────────────────────────────────────────────────────
target/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar   # The wrapper jar itself is intentionally committed
*.war
*.ear
*.nar

# Maven wrapper binary (downloaded on first use, not committed)
.mvn/wrapper/MavenWrapperDownloader.java

# JVM crash dumps
hs_err_pid*
replay_pid*

# Spring Boot dev tools local config
.spring-boot-devtools.properties
spring.log


# ── Node / npm / Frontend ─────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# TypeScript incremental compilation cache
*.tsbuildinfo

# ESLint cache
.eslintcache

# Vite local overrides (vite.config.local.ts, etc.)
*.local

# npm / yarn / pnpm debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Package manager lock files — keep package-lock.json (npm ci requires it);
# ignore yarn and pnpm locks to avoid conflicts if contributors switch tools
yarn.lock
pnpm-lock.yaml


# ── Docker ────────────────────────────────────────────────────────────────────
# Docker volumes are managed by Docker, never tracked in git
docker/volumes/

# Local docker-compose overrides (developer machine–specific port mappings, etc.)
docker-compose.override.yml


# ── Test output ───────────────────────────────────────────────────────────────
# JaCoCo and Surefire output lives under target/ (already ignored above),
# but an explicit entry makes the intent clear for contributors
coverage/
*.lcov


# ── IDE — IntelliJ IDEA ───────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/

# IntelliJ shelf (local VCS stash)
shelf/


# ── IDE — VS Code ─────────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json      # Extension recommendations are useful to share
!.vscode/settings.json.example


# ── IDE — Eclipse ─────────────────────────────────────────────────────────────
.classpath
.project
.settings/
.factorypath
bin/


# ── IDE — NetBeans ───────────────────────────────────────────────────────────
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/


# ── OS — macOS ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?


# ── OS — Windows ─────────────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk


# ── OS — Linux ────────────────────────────────────────────────────────────────
*~

# Vim swap files
*.swp
*.swo
*.swn

# Emacs backup files
\#*\#
.\#*


# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/


# ── Misc ─────────────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
*.rej
.cache/

# ── Office lock files (e.g. ~$report.docx, ~$deck.pptx) ──────────────────────
# These appear when a Microsoft Office app has the file open. They embed the
# operating-system user identity in the file contents — never commit them.
~$*

# ── Local one-off utility scripts (not part of the project) ──────────────────
scrub-history.ps1
