# SentinelAI environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in every value before running docker-compose
# or the Spring Boot backend.
#
#   cp .env.example .env
#
# NEVER commit .env to source control — it contains secrets and is listed in .gitignore.
# This file IS committed — it documents every variable with safe placeholder values.
# ─────────────────────────────────────────────────────────────────────────────


# ─── PostgreSQL ───────────────────────────────────────────────────────────────

# Name of the database created on first container startup
POSTGRES_DB=sentinelai

# PostgreSQL superuser username (used by both Docker and the Spring Boot backend)
POSTGRES_USER=sentinelai

# PostgreSQL password — use a long random string in any non-local environment
# Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=changeme

# Host port PostgreSQL is exposed on.
# Change this if port 5432 is already occupied by another PostgreSQL instance.
POSTGRES_PORT=5432


# ─── Spring Boot backend ──────────────────────────────────────────────────────

# Full JDBC connection URL for the Spring Boot datasource.
# When running Spring Boot outside Docker, this connects to the Docker-exposed port.
DB_URL=jdbc:postgresql://localhost:5432/sentinelai

# Spring Boot reads DB_USERNAME, not POSTGRES_USER — keep these in sync
DB_USERNAME=sentinelai

# Spring Boot reads DB_PASSWORD, not POSTGRES_PASSWORD — keep these in sync
DB_PASSWORD=changeme

# Port the Spring Boot backend HTTP server listens on
SERVER_PORT=8080

# Set to true to log every SQL statement to stdout — useful for debugging, noisy in prod
SHOW_SQL=false


# ─── Detection strategy (pluggable) ──────────────────────────────────────────
# SentinelAI is a governance + audit platform. Scoring prompts for injection
# risk is OPT-IN — the audit trail is always present, scoring is a feature on
# top.
#
# Choose ONE strategy:
#   none     — no scoring. Every audit row has risk_score=NULL. (Default.)
#   rules    — in-process regex + keyword scorer. Catches well-known prompt-
#              injection patterns. NO data leaves your environment. Free.
#   external — POSTs each prompt to a third-party detection HTTP API
#              (Lakera Guard, Protect AI, your own service). OPT-IN ONLY —
#              the prompt text leaves your environment to reach the detector.
DETECTION_STRATEGY=none

# ─── External detection (only used when DETECTION_STRATEGY=external) ────────
# Base URL of the external detection service.
DETECTION_API_URL=
# API key for the detection service — never commit a real key.
DETECTION_API_KEY=
# Maximum milliseconds to wait for a detection response.
# On timeout, risk_score is logged as null and the proxy continues normally —
# a timeout never blocks or fails the AI response returned to the caller.
DETECTION_TIMEOUT_MS=5000


# ─── License and retention ───────────────────────────────────────────────────

# License key issued by SentinelAI.
# Leave blank for the free tier (7-day log retention).
# Paid keys unlock 30 / 90 / 365-day retention tiers.
LICENSE_KEY=


# ─── AI model providers (Phase 5) ────────────────────────────────────────────
# Configure only the providers you actually use.
# Unconfigured providers will return an error at call time, not at startup.

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Base URL for OpenAI Chat Completions (also works with OpenAI-compatible providers
# like Groq, Together AI, Mistral — just change the URL).
OPENAI_API_URL=https://api.openai.com/v1

# Your OpenAI API key (sk-...). Keep this secret.
OPENAI_API_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Base URL for Anthropic Messages API.
ANTHROPIC_API_URL=https://api.anthropic.com

# Your Anthropic API key. Keep this secret.
ANTHROPIC_API_KEY=

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Base URL for the Gemini generateContent REST API.
GEMINI_API_URL=https://generativelanguage.googleapis.com

# Your Google AI Studio API key (sent as ?key= query param — not a header).
GEMINI_API_KEY=

# ── Azure OpenAI ──────────────────────────────────────────────────────────────
# Your Azure OpenAI resource endpoint, from the Azure portal.
# Format: https://{your-resource-name}.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Your Azure OpenAI API key (from Keys + Endpoint in the Azure portal).
AZURE_OPENAI_API_KEY=

# The deployment name you created in Azure OpenAI Studio.
# This is NOT the model name — it's the name you chose when creating the deployment.
AZURE_OPENAI_DEPLOYMENT=

# Azure OpenAI REST API version. Pin this to avoid unexpected breaking changes.
AZURE_OPENAI_API_VERSION=2024-02-01

# ─── API key authentication (Phase 6) ────────────────────────────────────────
# Comma-separated list of valid API keys callers must include as X-Sentinel-Api-Key.
# Leave blank to DISABLE authentication — all requests are accepted (development default).
# Example: SENTINEL_API_KEYS=sk-sentinel-abc123,sk-sentinel-def456
SENTINEL_API_KEYS=

# ─── Rate limiting (Phase 6) ──────────────────────────────────────────────────
# Maximum tokens per IP bucket — controls burst capacity.
# At the defaults, each IP can send 60 requests in a burst then ~1/second thereafter.
RATE_LIMIT_CAPACITY=60

# Tokens refilled per minute (controls sustained throughput).
RATE_LIMIT_REFILL_PER_MINUTE=60

# Set to true ONLY when running behind a trusted reverse proxy (Nginx, AWS ALB, etc.)
# that sets X-Forwarded-For to the real client IP before forwarding.
# Leave false (the default) for direct deployments — forged XFF headers are ignored.
RATE_LIMIT_TRUST_PROXY=false

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins the browser dashboard is allowed to call from.
# In production, set this to your actual dashboard domain.
# Example: CORS_ALLOWED_ORIGINS=https://app.sentinelai.io
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Async thread pool ────────────────────────────────────────────────────────
# Tune these for the number of vCPUs and expected audit write volume.
# Defaults are safe for a 2–4 vCPU container.
ASYNC_CORE_POOL_SIZE=4
ASYNC_MAX_POOL_SIZE=20
ASYNC_QUEUE_CAPACITY=500

# ── Frontend ──────────────────────────────────────────────────────────────────
# License key shown in the Settings page (read at build time via VITE_LICENSE_KEY).
# Set this to the same value as LICENSE_KEY if you want the dashboard to display
# the correct tier. Leave blank to show FREE tier in the Settings page.
VITE_LICENSE_KEY=
